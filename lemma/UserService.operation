// LEMMA Operation (Deployment) Model - User Service
// Matches the professor's customerCore.operation (deployment_base + javaWithSpring, Kubernetes).
//
// The "eureka" import + "depends on nodes" line model that your service registers with Eureka.
// They rely on your eureka-server folder having an eurekaServer.operation with a ServiceDiscovery
// node (the professor's project has one). If either line shows red, just delete those two lines.

import microservices from "UserService.services" as userServices
import technology from "../technology/deployment_base.technology" as deploymentBase
import technology from "../technology/javaWithSpring.technology" as protocolTechnology
import nodes from "../eureka-server/eurekaServer.operation" as eureka

@technology(deploymentBase)
@technology(protocolTechnology)
container UserServiceContainer deployment technology deploymentBase::_deployment.Kubernetes
	deploys userServices::com.example.userservice.UserService
	depends on nodes eureka::ServiceDiscovery {
	userServices::com.example.userservice.UserService {
		Dockerfile('
			FROM openjdk:17-jdk-alpine
			COPY target/User_Service-0.0.1-SNAPSHOT.jar /app.jar
			EXPOSE 8082
			ENTRYPOINT ["java","-jar","/app.jar"]
		')

		basic endpoints { protocolTechnology::_protocols.rest: "http://localhost:8082"; }
	}
}
