import microservices from "MediaService.services" as services
import technology from "../technology/docker.technology" as docker
import technology from "../technology/javaWithSpring.technology" as protocol

/*
 * LEMMA Operation (Deployment) Model - Media_Service.
 * Models the Docker container that deploys the microservice
 * (Assignment 6, Task 3 - Deployment Modeling).
 */

@technology(docker)
@technology(protocol)
container MediaServiceContainer deployment technology docker::_deployment.Docker
    deploys services::com.example.media.MediaService {
    services::com.example.media.MediaService {
        Dockerfile('
            FROM eclipse-temurin:17-jdk
            COPY target/Media_Service-0.0.1-SNAPSHOT.jar app.jar
            EXPOSE 8085
            ENTRYPOINT ["java","-jar","/app.jar"]
        ')

        ComposePart('
            media-service:
                build: Media_Service
                image: backdoor/media-service
                depends_on:
                  - eureka-server
                  - config-server
                environment:
                  - "EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://eureka-server:8761/eureka"
                  - "SPRING_CONFIG_IMPORT=optional:configserver:http://config-server:8888"
                ports:
                  - "8085:8085"
        ')

        basic endpoints { protocol::_protocols.rest: "http://localhost:8085"; }
    }
}
