import microservices from "UserService.services" as userServices
import technology from "../technology/docker.technology" as docker
import technology from "../technology/javaWithSpring.technology" as protocolTechnology

/*
 * LEMMA Operation (Deployment) Model - User Service.
 * Models the Docker container that deploys the microservice
 * (Assignment 6, Task 3 - Deployment Modeling).
 */

@technology(docker)
@technology(protocolTechnology)
container UserServiceContainer deployment technology docker::_deployment.Docker
    deploys userServices::com.example.userservice.UserService {
    userServices::com.example.userservice.UserService {
        Dockerfile('
            FROM eclipse-temurin:17-jdk
            COPY target/User_Service-0.0.1-SNAPSHOT.jar app.jar
            EXPOSE 8082
            ENTRYPOINT ["java","-jar","/app.jar"]
        ')

        ComposePart('
            user-service:
                build: User_Service
                image: backdoor/user-service
                depends_on:
                  - eureka-server
                  - config-server
                environment:
                  - "EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://eureka-server:8761/eureka"
                  - "SPRING_CONFIG_IMPORT=optional:configserver:http://config-server:8888"
                ports:
                  - "8082:8082"
        ')

        basic endpoints { protocolTechnology::_protocols.rest: "http://localhost:8082"; }
    }
}
